GEMINI_API_KEY=your_api_key_here
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
NODE_ENV=development
CHATBOT_PROVIDER_MODE=auto
VIDEOSDK_API_KEY=your_videosdk_api_key_here
VIDEOSDK_API_SECRET=your_videosdk_secret_here
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_here
# Face verification for notarial flow (selfie vs government ID)
# Option A — Face++ (recommended: free tier, no Azure subscription)
# Sign up: https://console.faceplusplus.com  → API Key / API Secret
FACEPLUS_API_KEY=
FACEPLUS_API_SECRET=
# Optional: default https://api-us.faceplusplus.com (use api-cn.faceplusplus.com if your account is China region)
# FACEPLUS_API_BASE=https://api-us.faceplusplus.com

# Option B — Azure Face (requires subscription + limited-access approval for verify)
# AZURE_FACE_KEY=your_azure_face_api_key_here
# AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Minimum match score 0–100 (default 75). Optional:
# FACE_VERIFY_MIN_CONFIDENCE=75
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Prefer your SPA root (/) so PayMongo return avoids auth flash; app redirects clients to dashboard.
PAYMENT_SUCCESS_URL=https://your-frontend-domain/
PAYMENT_CANCEL_URL=https://your-frontend-domain/my-appointments

# Client self-signup OTP (pending_signups table — run database/20260518_pending_client_signups.sql)
# IPROG_API_KEY=your_iprog_token   # required for SMS OTP channel
#
# IMPORTANT: Signup OTP must reach ANY @gmail.com address your users enter.
# - Use Gmail SMTP below (recommended for production/testing with your group).
# - Resend "onboarding@resend.dev" ONLY delivers to the Resend account owner email — not all signups.

# Welcome email when admin adds a new attorney (credentials sent to their inbox)
# Option A — Resend (recommended): https://resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxx
# WELCOME_EMAIL_FROM=BatasMo <onboarding@resend.dev>
#   (testing: onboarding@resend.dev only delivers to your Resend account email)
#   (production: verify your domain, e.g. noreply@batasmo.app)

# Option B — Gmail SMTP (email arrives in recipient's Gmail inbox)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.team@gmail.com
# SMTP_PASS=your-16-char-google-app-password
# WELCOME_EMAIL_FROM=BatasMo <your.team@gmail.com>

# Login link in the welcome email (defaults to ALLOWED_ORIGIN + /login)
# APP_LOGIN_URL=https://batasmo-web.vercel.app/login
