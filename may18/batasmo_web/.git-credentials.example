# Copy this file to `.git-credentials` (no .example suffix) and fill in your
# real values. `.git-credentials` is gitignored, so it never reaches GitHub.
#
# How to get a token:
#   1. Open https://github.com/settings/tokens
#   2. Click "Generate new token" -> "Generate new token (classic)"
#   3. Note: e.g. "Mac CLI". Expiration: 90 days. Scope: tick `repo`.
#   4. Click "Generate token" and copy the value (you only see it once).

GITHUB_TOKEN=ghp_paste_your_personal_access_token_here
GITHUB_USERNAME=shaeijmnz
GIT_AUTHOR_NAME=Your Full Name
GIT_AUTHOR_EMAIL=you@example.com
