GEMINI_API_KEY=your_api_key_here
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
NODE_ENV=development
CHATBOT_PROVIDER_MODE=auto
VIDEOSDK_API_KEY=your_videosdk_api_key_here
VIDEOSDK_API_SECRET=your_videosdk_secret_here
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_here
# Face verification for notarial flow (selfie vs government ID)
# Option A — Face++ (recommended: free tier, no Azure subscription)
# Sign up: https://console.faceplusplus.com  → API Key / API Secret
FACEPLUS_API_KEY=
FACEPLUS_API_SECRET=
# Optional: default https://api-us.faceplusplus.com (use api-cn.faceplusplus.com if your account is China region)
# FACEPLUS_API_BASE=https://api-us.faceplusplus.com

# Option B — Azure Face (requires subscription + limited-access approval for verify)
# AZURE_FACE_KEY=your_azure_face_api_key_here
# AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Minimum match score 0–100 (default 75). Optional:
# FACE_VERIFY_MIN_CONFIDENCE=75
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Prefer your SPA root (/) so PayMongo return avoids auth flash; app redirects clients to dashboard.
PAYMENT_SUCCESS_URL=https://your-frontend-domain/
PAYMENT_CANCEL_URL=https://your-frontend-domain/my-appointments
