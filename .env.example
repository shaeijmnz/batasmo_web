# Supabase (required for login on Vercel). Use legacy anon JWT (eyJ…), NOT sb_publishable_.
# Vercel: Project → Settings → Environment Variables → add both, then Redeploy.
REACT_APP_SUPABASE_URL=https://sjmmyqeqiigmclcgcadr.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_legacy_anon_jwt_here

REACT_APP_CHATBOT_API_URL=https://batasmo-web.onrender.com
REACT_APP_PAYMENT_API_URL=https://batasmo-web.onrender.com

# Render backend — signup OTP email (Gmail: use App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your@gmail.com
REACT_APP_VIDEOSDK_TOKEN=your_videosdk_token_here
# true = chat room opens even before scheduled time (testing only). Use false in production.
REACT_APP_BYPASS_CHAT_WINDOW=false
